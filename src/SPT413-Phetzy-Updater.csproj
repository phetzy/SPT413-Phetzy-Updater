<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SPT413-Phetzy-Updater</AssemblyName>
    <RootNamespace>Phetzy.Spt413Updater</RootNamespace>
    <Version>1.0.2</Version>
    <FileVersion>1.0.2.0</FileVersion>
    <Product>SPT 4.1.3 Phetzy Updater</Product>
    <Description>Validated GUI updater for the SPT 4.1.3 mod pack.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="payload\JBOBYH_ItemPreviewQoL.dll"
                      LogicalName="Phetzy.Spt413Updater.Payload.JBOBYH_ItemPreviewQoL.dll" />
  </ItemGroup>
</Project>
